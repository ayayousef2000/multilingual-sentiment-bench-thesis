%%% Headings Style (Chapter, Section, Subsection) %%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\setsecnumdepth{subsection}

\makeatletter
\newbool{mem@starred@chapter}
\pretocmd{\@schapter}{\booltrue{mem@starred@chapter}}{}{}
\pretocmd{\@chapter}{\boolfalse{mem@starred@chapter}}{}{}
\pretocmd{\tableofcontents}{\booltrue{mem@starred@chapter}}{}{}
\pretocmd{\listoffigures}{\booltrue{mem@starred@chapter}}{}{}
\pretocmd{\listoftables}{\booltrue{mem@starred@chapter}}{}{}

\makechapterstyle{mythesis}{%
  \renewcommand*{\chapterheadstart}{}
  \renewcommand*{\printchaptername}{}
  \renewcommand*{\chapnumfont}{\normalfont\bfseries}
  \renewcommand*{\printchapternum}{}
  \renewcommand*{\afterchapternum}{}
  \renewcommand*{\printchaptertitle}[1]{%
    \normalfont\bfseries%
    \ifbool{mem@starred@chapter}{%
      \begin{center}\MakeUppercase{##1}\end{center}\vspace{-0.8\baselineskip}%
    }{%
      \noindent\hspace{1.25cm}\MakeUppercase{\thechapter\hspace{1em}##1}\par%
    }}
  \setlength{\beforechapskip}{0pt}
  \setlength{\afterchapskip}{6pt}
}
\makeatother
\chapterstyle{mythesis}

\AtBeginDocument{\parindent=1.25cm}

% --- SECTION SETTINGS ---
\setsecindent{0pt}
\setsecheadstyle{%
  \raggedright\normalfont\bfseries
  \parshape 2 1.25cm \dimexpr\textwidth-1.25cm\relax 0pt \textwidth
}

% --- SUBSECTION SETTINGS ---
\setsubsecindent{0pt}
\setsubsecheadstyle{%
  \raggedright\normalfont\bfseries
  \parshape 2 1.25cm \dimexpr\textwidth-1.25cm\relax 0pt \textwidth
}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%%% Table of Contents (ToC) Settings %%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\addto\captionsrussian{\renewcommand\contentsname{Содержание}}
\setrmarg{2.55em plus1fil}
\renewcommand{\aftertoctitle}{\afterchaptertitle \vspace{-\cftbeforechapterskip}\vspace{0.5\baselineskip}}
\renewcommand*{\cftchapternumwidth}{1.5em}
\renewcommand*{\cftchapterfont}{\normalfont\MakeUppercase}
\renewcommand*{\cftchapterpagefont}{\normalfont}
\renewcommand*{\cftchapterdotsep}{\cftdotsep}
\renewcommand*{\cftdotsep}{1}
\renewcommand*{\cftchapterleader}{\cftdotfill{\cftchapterdotsep}}
\maxtocdepth{subsection}
\renewcommand{\afterloftitle}{\vspace{10pt}}
\renewcommand{\lofheadstart}{\centering}
\renewcommand{\afterlottitle}{\vspace{10pt}}
\renewcommand{\lotheadstart}{\centering}
%% --- ToC vertical spacing (1.5 rhythm) ---
\setlength{\cftbeforechapterskip}{0.5\baselineskip}%
\setlength{\cftbeforesectionskip}{0.5\baselineskip}%
\setlength{\cftbeforesubsectionskip}{0.5\baselineskip}%
