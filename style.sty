%%% Bibliography (BibLaTeX + Biber + GOST) %%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\usepackage{csquotes}
\usepackage{lipsum}
\usepackage[
    backend=biber,
    bibencoding=utf8,
    sorting=none,
    style=gost-numeric,
    language=auto,
    autolang=other,
    sortcites=true,
    movenames=false,
    maxnames=4,
    minnames=4,
    doi=true,
    isbn=true,
]{biblatex}

\DeclareDelimFormat{bibinitdelim}{}
\addbibresource{references.bib}

\DeclareSourcemap{
  \maps[datatype=bibtex]{
    \map{
        \step[fieldsource=title, match=\regexp{^\P{Cyrillic}*\p{Cyrillic}.*}, final]
        \step[fieldset=langid, fieldvalue={russian}]
    }
    \map{
        \step[fieldset=langid, fieldvalue={english}]
    }
  }
}
