%%% ALL spacing forced here — single AtBeginDocument, nothing can override %%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\AtBeginDocument{%
    %% --- Typography fixes ---
    \tolerance=10000
    \hbadness=10000
    \vbadness=10000
    \emergencystretch=3em
    \hfuzz=5pt
    \vfuzz=5pt
    \sloppy
    \hyphenpenalty=10000
    \exhyphenpenalty=10000
    %% --- Cancel parskip stacking ---
    \setlength{\parskip}{0pt}%
    %% --- Chapter heading spacing ---
    \setlength{\beforechapskip}{0pt}%
    \setlength{\afterchapskip}{6pt}%
    %% --- Section spacing ---
    \setlength{\beforesecskip}{18pt}%
    \setlength{\aftersecskip}{6pt}%
    %% --- Subsection spacing ---
    \setlength{\beforesubsecskip}{18pt}%
    \setlength{\aftersubsecskip}{6pt}%
    %% --- Float spacing ---
    \setlength{\abovecaptionskip}{6pt}%
    \setlength{\belowcaptionskip}{0pt}%
    \setlength{\textfloatsep}{3pt plus 1pt minus 1pt}%
    \setlength{\floatsep}{6pt plus 1pt minus 1pt}%
    \setlength{\intextsep}{6pt plus 1pt minus 1pt}%
    %% --- Force all floats to place here ---
    \floatplacement{figure}{H}%
    \floatplacement{table}{H}%
    %% --- Table caption alignment and spacing ---
    \setfloatadjustment{table}{%
        \captionstyle{\raggedright}%
        \setlength{\belowcaptionskip}{6pt}%
    }%
}
