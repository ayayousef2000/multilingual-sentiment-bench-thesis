%%% Equation spacing (etoolbox — bypass memoir overrides) %%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\usepackage{etoolbox}
\BeforeBeginEnvironment{equation}{\vspace{0pt}}
\AfterEndEnvironment{equation}{\vspace{0pt}}
\BeforeBeginEnvironment{figure}{\vspace{8pt}}
\BeforeBeginEnvironment{table}{\vspace{6pt}}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%%% ALL spacing forced here — single AtBeginDocument, nothing can override %%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\AtBeginDocument{%
    %% --- Typography fixes ---
    \tolerance=10000
    \hbadness=10000
    \vbadness=10000
    \emergencystretch=3em
    \hfuzz=5pt
    \vfuzz=5pt
    \sloppy
    \hyphenpenalty=10000
    \exhyphenpenalty=10000
    %% --- Cancel parskip stacking ---
    \setlength{\parskip}{0pt}%
    %% --- Chapter heading spacing ---
    \setlength{\beforechapskip}{0pt}%
    \setlength{\afterchapskip}{1pt}%
    %% --- Section spacing ---
    \setlength{\beforesecskip}{1pt}%
    \setlength{\aftersecskip}{1pt}%
    %% --- Subsection spacing ---
    \setlength{\beforesubsecskip}{18pt}%
    \setlength{\aftersubsecskip}{6pt}%
    %% --- Float spacing ---
    \setlength{\abovecaptionskip}{0pt}%
    \setlength{\belowcaptionskip}{-2pt}%
    \setlength{\textfloatsep}{0pt}%
    \setlength{\floatsep}{0pt}%
    \setlength{\intextsep}{0pt}%
    %% --- Force all floats to place here ---
    \floatplacement{figure}{H}%
    \floatplacement{table}{H}%
    %% --- Table caption alignment and spacing ---
    \setfloatadjustment{table}{%
        \captionstyle{\raggedright}%
        \setlength{\belowcaptionskip}{6pt}%
    }%
}
